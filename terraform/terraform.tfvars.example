# Terraform Variables
# Copy this file to terraform.tfvars and update values

# AWS Configuration
aws_region    = "eu-west-1"  # Change to your region
instance_type = "t3.micro"    # Or t2.micro for cheaper

# Project
project_name = "smart-pet-feeder"

# SSH Key Pair (must exist in AWS)
# Create with: aws ec2 create-key-pair --key-name production-key --query 'KeyMaterial' --output text > production-key.pem
key_name = "your-key-pair-name"

# API Configuration
api_key = "change-this-to-a-secure-random-key"
